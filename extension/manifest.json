{
  "name": "E2E Wallet",
  "description": "Automation-first injected wallet backed by a shared local signer.",
  "version": "1.0.0",
  "manifest_version": 3,
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8547/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
